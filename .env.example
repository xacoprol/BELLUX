# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-CDPPECXSK8

# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://belluxentertainment.com

# WordPress media
NEXT_PUBLIC_WP_URL=https://admin.belluxentertainment.com

# Maintenance gate (off by default). Set to true only to lock the site again.
# MAINTENANCE_MODE=false

# Instagram profile link (public)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/belluxentertainment

# Instagram Graph API (optional — live feed)
# Requires Instagram Business/Creator account linked to a Facebook Page
# + long-lived access token from Meta Developers
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Contact form → IONOS SMTP
# Host: smtp.ionos.es | smtp.ionos.com | smtp.ionos.pt
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
# SMTP_SECURE=true   # use with port 465
SMTP_USER=info@tudominio.com
SMTP_PASS=
# Optional override (defaults to "Bellux Entertainment <SMTP_USER>")
# SMTP_FROM=Bellux Entertainment <info@tudominio.com>
# Inbox that receives leads (defaults to SMTP_USER)
CONTACT_TO=info@tudominio.com
